VITE_GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID is for development; supply your JavaScript map ID for production.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Optional override; empty uses the bundled, manually traced Ward 7 boundary.
VITE_WARDS_GEOJSON_URL=
# Optional override; empty uses the real first-flight metadata at /drone/surveys.json.
VITE_SURVEYS_METADATA_URL=
